# Next rewrites use this server-side origin for the Go API.
GO_API_URL=http://localhost:8080

# Optional dashboard URL shown in the header.
NEXT_PUBLIC_GRAFANA_DASHBOARD_URL=

# Optional Microsoft Clarity project ID. Leave empty to disable tracking.
NEXT_PUBLIC_CLARITY_ID=

# Must match the Go API token. Keep server-side; do not prefix with NEXT_PUBLIC_.
DEMO_RESET_TOKEN=change-this-to-a-long-random-secret
