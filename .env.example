# Copia esta URL desde Neon > Connect. Conserva sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DB?sslmode=require
PORT=8080
GIN_MODE=release
DB_MAX_CONNS=30
DB_MIN_CONNS=2

# Usa el mismo secreto en el backend y en el frontend para limpiar una corrida demo.
DEMO_RESET_TOKEN=replace-with-a-long-random-secret
